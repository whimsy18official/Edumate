                    <span>Aktivitas Login Terakhir Siswa</span>
                  </h3>
                </div>

                <div class="space-y-2 max-h-64 overflow-y-auto pr-1">
                  ${appState.students.map(st => {
                    const cName = appState.classes.find(c => c.id === st.classId)?.name || '-';
                    return `
                      <div class="flex items-center justify-between p-2.5 rounded-2xl bg-edubg border border-eduborder text-xs">
                        <div class="flex items-center gap-2.5">
