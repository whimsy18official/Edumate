          </div>
          <div>
            <label class="block text-xs font-bold text-edutext mb-1">Pilih Anggota Siswa (Centang)</label>
            <div class="space-y-1.5 max-h-48 overflow-y-auto p-2 bg-edubg rounded-xl border border-eduborder text-xs">
              ${classStudents.map(st => `
                <label class="flex items-center gap-2 p-1 hover:bg-white rounded cursor-pointer">
                  <input type="checkbox" name="grp_member" value="${st.id}" class="accent-amber-500">
                  <span class="font-medium text-edutext">${st.fullName}</span>
                </label>
              `).join('')}
            </div>
          </div>
          <div class="flex justify-end gap-2">
            <button type="button" onclick="closeModal()" class="px-4 py-2 rounded-xl bg-edubg text-xs font-bold text-edumuted">Batal</button>
