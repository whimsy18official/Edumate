    function handleTeacherLogin(e) {
      e.preventDefault();
      const user = document.getElementById('guru-user').value.trim();
      const pass = document.getElementById('guru-pass').value.trim();

      if (user === appState.teacherProfile.username && pass === appState.teacherProfile.password) {
        appState.currentUser = {
          role: 'guru',
          username: user,
          name: appState.teacherProfile.fullName
        };
        saveState();
        showToast('Berhasil masuk sebagai Guru: ' + appState.teacherProfile.fullName);
        renderApp();
      } else {
        showToast('Username atau password guru salah!', 'warning');
      }
    }

    function handleStudentLogin(e) {
      e.preventDefault();
      const classId = document.getElementById('siswa-class').value;
      const name = document.getElementById('siswa-name').value.trim();
      const pass = document.getElementById('siswa-pass').value.trim();

      const student = appState.students.find(s => 
        s.classId === classId && 
        s.fullName.toLowerCase() === name.toLowerCase()
      );

      if (!student) {
        showToast('Siswa tidak ditemukan di kelas yang dipilih.', 'warning');
        return;
      }

      if (student.password !== pass) {
        showToast('Password siswa salah!', 'warning');
        return;
      }

      const now = new Date();
      student.lastLogin = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')} ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;
      
      appState.currentUser = {
        role: 'siswa',
        id: student.id,
        name: student.fullName,
        username: student.username,
        classId: student.classId
      };
      saveState();
      showToast(`Selamat datang, ${student.fullName}!`);
      renderApp();
    }

