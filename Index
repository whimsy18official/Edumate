                                <input type="number" min="0" max="100" value="${sub?.score !== undefined && sub?.score !== null ? sub.score : ''}" ${ass.type === 'quiz_pg' ? 'readonly' : ''} onchange="updateAssessmentGrade('${ass.id}', '${st.id}', this.value)" class="w-16 px-2 py-1 text-center font-bold text-xs bg-edubg rounded-xl border border-eduborder outline-none focus:border-edupurple ${ass.type === 'quiz_pg' ? 'bg-gray-100 cursor-not-allowed' : ''}">
                              </div>
                            </div>
                          </div>
                        `;
                      }).join('')}
                    </div>
                  </div>

                  <div class="pt-2">
                    <span class="text-xs font-bold text-edumuted flex items-center gap-1 mb-2">
                      <i class="fa-solid fa-comments"></i> Diskusi Tugas / Quiz (${(ass.comments || []).length})
                    </span>
                    <div class="space-y-1.5 max-h-36 overflow-y-auto pr-1">
                      ${(ass.comments || []).map(c => `
                        <div class="bg-edubg rounded-xl p-2 text-xs border border-eduborder flex justify-between">
                          <span><strong class="${c.role === 'guru' ? 'text-edupurple' : 'text-edupinkDark'}">${c.author}:</strong> ${c.text}</span>
                          <span class="text-[10px] text-edumuted">${c.date}</span>
                        </div>
                      `).join('')}
                    </div>
                  </div>

                </div>
              `;
            }).join('')}
          </div>
        </div>
      `;
    }

    // Modal with Dynamic Multi-Question Builder for PG Quiz
    let currentPGQuestionsCount = 1;

    function renderSinglePGQuestionHTML(index) {
      return `
        <div id="pg-block-${index}" class="p-3.5 bg-edubg rounded-2xl text-xs space-y-2 border border-eduborder relative">
          <div class="flex items-center justify-between">
            <span class="font-bold text-edutext">Butir Soal PG ${index}</span>
            ${index > 1 ? `
              <button type="button" onclick="removePGQuestionBlock(${index})" class="text-edumuted hover:text-red-500 text-xs font-bold">
                <i class="fa-solid fa-trash-can"></i> Hapus
              </button>
            ` : ''}
          </div>
          <input type="text" name="pg_q_text" required placeholder="Pertanyaan soal nomor ${index}..." class="w-full px-3 py-2 bg-white rounded-xl text-xs font-medium outline-none border border-eduborder">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
            <input type="text" name="pg_op_a" required placeholder="Pilihan A..." class="w-full px-3 py-1.5 bg-white rounded-xl text-xs outline-none border border-eduborder">
            <input type="text" name="pg_op_b" required placeholder="Pilihan B..." class="w-full px-3 py-1.5 bg-white rounded-xl text-xs outline-none border border-eduborder">
            <input type="text" name="pg_op_c" required placeholder="Pilihan C..." class="w-full px-3 py-1.5 bg-white rounded-xl text-xs outline-none border border-eduborder">
            <input type="text" name="pg_op_d" required placeholder="Pilihan D..." class="w-full px-3 py-1.5 bg-white rounded-xl text-xs outline-none border border-eduborder">
          </div>
          <div class="flex items-center justify-between pt-1">
            <span class="font-bold text-edumuted text-[11px]">Kunci Jawaban Benar:</span>
            <select name="pg_correct" class="px-2.5 py-1 bg-white rounded-lg border border-eduborder text-xs font-bold text-edupurple">
              <option value="0">Opsi A</option>
              <option value="1">Opsi B</option>
              <option value="2">Opsi C</option>
              <option value="3">Opsi D</option>
            </select>
          </div>
        </div>
      `;
    }

    function addPGQuestionBlock() {
      currentPGQuestionsCount++;
      const container = document.getElementById('pg-questions-container');
      const tempDiv = document.createElement('div');
      tempDiv.innerHTML = renderSinglePGQuestionHTML(currentPGQuestionsCount);
      container.appendChild(tempDiv.firstElementChild);
    }

    function removePGQuestionBlock(index) {
      const block = document.getElementById(`pg-block-${index}`);
      if (block) block.remove();
    }

    function promptCreateQuizPG(classId) {
      currentPGQuestionsCount = 1;
      const html = `
        <form onsubmit="handleConfirmCreateQuizPG(event, '${classId}')" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="sm:col-span-2">
              <label class="block text-xs font-bold text-edutext mb-1">Judul Quiz PG</label>
              <input type="text" id="qpg-title" required placeholder="Contoh: Quiz 2: Eksponen & Logaritma" class="w-full px-4 py-2 bg-edubg rounded-2xl border border-eduborder text-xs font-bold outline-none focus:border-edupurple">
            </div>
            <div>
              <label class="block text-xs font-bold text-edutext mb-1">Durasi Timer (Menit)</label>
              <input type="number" id="qpg-duration" value="15" min="1" max="180" required class="w-full px-4 py-2 bg-edubg rounded-2xl border border-eduborder text-xs font-bold outline-none focus:border-edupurple">
            </div>
          </div>
          <div>
            <label class="block text-xs font-bold text-edutext mb-1">Tenggat Waktu</label>
            <input type="date" id="qpg-due" required class="w-full px-4 py-2 bg-edubg rounded-2xl border border-eduborder text-xs font-medium outline-none focus:border-edupurple">
          </div>

          <div class="flex items-center justify-between pt-2">
            <span class="text-xs font-bold text-edupurple">Daftar Butir Soal Pilihan Ganda</span>
            <button type="button" onclick="addPGQuestionBlock()" class="px-3 py-1.5 rounded-xl bg-edupurpleLight text-edupurple hover:bg-edupurple hover:text-white font-bold text-xs transition flex items-center gap-1">
              <i class="fa-solid fa-plus text-[10px]"></i> Tambah Nomor Soal
            </button>
          </div>

          <!-- Dynamic Questions Container -->
          <div id="pg-questions-container" class="space-y-3 max-h-80 overflow-y-auto pr-1">
            ${renderSinglePGQuestionHTML(1)}
          </div>

          <div class="flex justify-end gap-2 pt-3 border-t border-eduborder">
            <button type="button" onclick="closeModal()" class="px-4 py-2 rounded-xl bg-edubg text-xs font-bold text-edumuted">Batal</button>
            <button type="submit" class="px-5 py-2 rounded-xl bg-edupurple text-white text-xs font-bold shadow-clay">Buat Kuis PG</button>
          </div>
        </form>
      `;
      openModal('Buat Kuis Pilihan Ganda (Banyak Soal & Timer)', html);
    }

    function handleConfirmCreateQuizPG(e, classId) {
      e.preventDefault();
      const title = document.getElementById('qpg-title').value.trim();
      const durationMinutes = Number(document.getElementById('qpg-duration').value) || 15;
      const dueDate = document.getElementById('qpg-due').value;

      const blocks = document.querySelectorAll('#pg-questions-container > div');
      const questions = [];

      blocks.forEach((block, idx) => {
        const text = block.querySelector('input[name="pg_q_text"]').value.trim();
        const opA = block.querySelector('input[name="pg_op_a"]').value.trim();
        const opB = block.querySelector('input[name="pg_op_b"]').value.trim();
        const opC = block.querySelector('input[name="pg_op_c"]').value.trim();
        const opD = block.querySelector('input[name="pg_op_d"]').value.trim();
        const correct = Number(block.querySelector('select[name="pg_correct"]').value);

        questions.push({
          id: 'q_' + (idx + 1),
          text,
          options: [opA, opB, opC, opD],
          correct
        });
      });

      if (questions.length === 0) return;

      const newGradeCol = {
        id: 'g_' + Date.now(),
        classId,
        title: title
      };
      appState.gradeColumns.push(newGradeCol);

      appState.assessments.push({
        id: 'ass_' + Date.now(),
        classId,
        type: 'quiz_pg',
        title,
        durationMinutes,
        dueDate,
        gradeColId: newGradeCol.id,
        questions,
        submissions: {},
        comments: []
      });

      saveState();
      closeModal();
      showToast(`Kuis PG (${durationMinutes} menit) dengan ${questions.length} butir soal berhasil dibuat!`);
      renderTeacherActiveTab();
    }

    // Modal with Dynamic Multi-Question Builder for Essay Quiz
    let currentEssayQuestionsCount = 1;

    function renderSingleEssayQuestionHTML(index) {
      return `
        <div id="essay-block-${index}" class="p-3.5 bg-edubg rounded-2xl text-xs space-y-2 border border-eduborder relative">
          <div class="flex items-center justify-between">
            <span class="font-bold text-edutext">Butir Soal Esai ${index}</span>
            ${index > 1 ? `
              <button type="button" onclick="removeEssayQuestionBlock(${index})" class="text-edumuted hover:text-red-500 text-xs font-bold">
                <i class="fa-solid fa-trash-can"></i> Hapus
              </button>
            ` : ''}
          </div>
          <textarea name="essay_q_text" required rows="2" placeholder="Tuliskan petunjuk atau pertanyaan esai nomor ${index}..." class="w-full px-3 py-2 bg-white rounded-xl text-xs font-medium outline-none border border-eduborder resize-none"></textarea>
        </div>
      `;
    }

    function addEssayQuestionBlock() {
      currentEssayQuestionsCount++;
      const container = document.getElementById('essay-questions-container');
      const tempDiv = document.createElement('div');
      tempDiv.innerHTML = renderSingleEssayQuestionHTML(currentEssayQuestionsCount);
      container.appendChild(tempDiv.firstElementChild);
    }

    function removeEssayQuestionBlock(index) {
      const block = document.getElementById(`essay-block-${index}`);
      if (block) block.remove();
    }

    function promptCreateQuizEssay(classId) {
      currentEssayQuestionsCount = 1;
      const html = `
        <form onsubmit="handleConfirmCreateQuizEssay(event, '${classId}')" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="sm:col-span-2">
              <label class="block text-xs font-bold text-edutext mb-1">Judul Quiz Esai</label>
              <input type="text" id="qes-title" required placeholder="Contoh: Kuis Esai Analisis Statistika" class="w-full px-4 py-2 bg-edubg rounded-2xl border border-eduborder text-xs font-bold outline-none focus:border-edupurple">
            </div>
            <div>
              <label class="block text-xs font-bold text-edutext mb-1">Durasi Timer (Menit)</label>
              <input type="number" id="qes-duration" value="30" min="1" max="180" required class="w-full px-4 py-2 bg-edubg rounded-2xl border border-eduborder text-xs font-bold outline-none focus:border-edupurple">
            </div>
          </div>
          <div>
            <label class="block text-xs font-bold text-edutext mb-1">Tenggat Waktu</label>
            <input type="date" id="qes-due" required class="w-full px-4 py-2 bg-edubg rounded-2xl border border-eduborder text-xs font-medium outline-none focus:border-edupurple">
          </div>

          <div class="flex items-center justify-between pt-2">
            <span class="text-xs font-bold text-edupinkDark">Daftar Pertanyaan Esai</span>
            <button type="button" onclick="addEssayQuestionBlock()" class="px-3 py-1.5 rounded-xl bg-edupinkSoft text-edupinkDark hover:bg-edupink hover:text-white font-bold text-xs transition flex items-center gap-1">
              <i class="fa-solid fa-plus text-[10px]"></i> Tambah Butir Soal
            </button>
          </div>

          <div id="essay-questions-container" class="space-y-3 max-h-80 overflow-y-auto pr-1">
            ${renderSingleEssayQuestionHTML(1)}
          </div>

          <div class="flex justify-end gap-2 pt-3 border-t border-eduborder">
            <button type="button" onclick="closeModal()" class="px-4 py-2 rounded-xl bg-edubg text-xs font-bold text-edumuted">Batal</button>
            <button type="submit" class="px-5 py-2 rounded-xl bg-edupink text-white text-xs font-bold shadow-soft">Buat Kuis Esai</button>
          </div>
        </form>
      `;
      openModal('Buat Kuis Esai (Banyak Soal & Timer)', html);
    }

    function handleConfirmCreateQuizEssay(e, classId) {
      e.preventDefault();
      const title = document.getElementById('qes-title').value.trim();
      const durationMinutes = Number(document.getElementById('qes-duration').value) || 30;
      const dueDate = document.getElementById('qes-due').value;

      const blocks = document.querySelectorAll('#essay-questions-container > div');
      const questions = [];

      blocks.forEach(block => {
        const text = block.querySelector('textarea[name="essay_q_text"]').value.trim();
        if (text) questions.push(text);
      });

      if (questions.length === 0) return;

      const newGradeCol = {
        id: 'g_' + Date.now(),
        classId,
        title: title
      };
      appState.gradeColumns.push(newGradeCol);

      appState.assessments.push({
        id: 'ass_' + Date.now(),
        classId,
        type: 'quiz_essay',
        title,
        durationMinutes,
        dueDate,
        gradeColId: newGradeCol.id,
        questions,
        submissions: {},
        comments: []
      });

      saveState();
      closeModal();
      showToast(`Kuis Esai (${durationMinutes} menit) dengan ${questions.length} butir pertanyaan berhasil dibuat!`);
      renderTeacherActiveTab();
    }

    function promptAddGroupToAssessment(assessmentId, classId) {
      const classStudents = appState.students.filter(s => s.classId === classId);
      const html = `
        <form onsubmit="handleSaveNewGroup(event, '${assessmentId}', '${classId}')" class="space-y-4">
