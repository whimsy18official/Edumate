    let quizTimerInterval = null;

    function startQuizTimer(durationMinutes, onExpireCallback) {
      if (quizTimerInterval) clearInterval(quizTimerInterval);
      let remainingSeconds = durationMinutes * 60;

      const timerDisplay = document.getElementById('quiz-timer-display');
      if (!timerDisplay) return;

      const updateDisplay = () => {
        const mins = Math.floor(remainingSeconds / 60);
        const secs = remainingSeconds % 60;
        timerDisplay.innerText = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
        if (remainingSeconds <= 60) {
          timerDisplay.classList.add('text-red-600', 'animate-pulse');
        }
      };

      updateDisplay();
      quizTimerInterval = setInterval(() => {
        remainingSeconds--;
        if (remainingSeconds <= 0) {
          clearInterval(quizTimerInterval);
          quizTimerInterval = null;
          showToast('Waktu pengerjaan kuis telah habis! Mengirim otomatis...', 'warning');
          if (typeof onExpireCallback === 'function') onExpireCallback();
        } else {
          updateDisplay();
        }
      }, 1000);
    }

