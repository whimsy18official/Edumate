          </div>
        </form>
      `;
      openModal('Tambah Kelompok Siswa', html);
    }

    function handleSaveNewGroup(e, assessmentId, classId) {
      e.preventDefault();
      const ass = appState.assessments.find(a => a.id === assessmentId);
      if (!ass) return;

      const groupName = document.getElementById('grp-new-name').value.trim();
      const selectedMembers = Array.from(e.target.querySelectorAll('input[name="grp_member"]:checked')).map(cb => cb.value);

      if (!ass.groups) ass.groups = [];
      const newGroup = {
        id: 'grp_' + Date.now(),
        name: groupName,
        memberStudentIds: selectedMembers,
        score: null
      };

      ass.groups.push(newGroup);
      saveState();
      closeModal();
      showToast(`Kelompok ${groupName} berhasil dibentuk!`);
      renderTeacherActiveTab();
    }

    function updateGroupAssessmentScore(assessmentId, groupId, scoreVal) {
      const ass = appState.assessments.find(a => a.id === assessmentId);
      if (!ass || !ass.groups) return;
      const grp = ass.groups.find(g => g.id === groupId);
      if (!grp) return;

      const numVal = scoreVal === '' ? null : Number(scoreVal);
      grp.score = numVal;

      if (!ass.submissions) ass.submissions = {};

      (grp.memberStudentIds || []).forEach(stId => {
        ass.submissions[stId] = {
          groupName: grp.name,
          score: numVal,
          submittedAt: new Date().toISOString()
        };

        if (ass.gradeColId) {
          if (!appState.gradeScores[ass.classId]) {
            appState.gradeScores[ass.classId] = {};
          }
          if (!appState.gradeScores[ass.classId][stId]) {
            appState.gradeScores[ass.classId][stId] = {};
          }
          appState.gradeScores[ass.classId][stId][ass.gradeColId] = numVal;
        }
      });

      saveState();
      showToast(`Nilai ${grp.name} berhasil disinkronkan ke seluruh anggota kelompok dan Buku Nilai!`);
      renderTeacherActiveTab();
    }

    function promptCreateGroupTask(classId) {
      const html = `
        <form onsubmit="handleConfirmCreateGroupTask(event, '${classId}')" class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-edutext mb-1">Judul Tugas Kelompok</label>
            <input type="text" id="grp-title" required placeholder="Contoh: Projek Kelompok: Analisis Data Statistik" class="w-full px-4 py-2 bg-edubg rounded-2xl border border-eduborder text-xs font-bold outline-none focus:border-edupurple">
          </div>
          <div>
            <label class="block text-xs font-bold text-edutext mb-1">Tenggat Waktu</label>
            <input type="date" id="grp-due" required class="w-full px-4 py-2 bg-edubg rounded-2xl border border-eduborder text-xs font-medium outline-none focus:border-edupurple">
          </div>
          <div>
            <label class="block text-xs font-bold text-edutext mb-1">Instruksi Pengerjaan Kelompok</label>
            <textarea id="grp-inst" required rows="3" placeholder="Deskripsi tugas dan ketentuan kelompok..." class="w-full px-3 py-2 bg-edubg rounded-2xl border border-eduborder text-xs outline-none focus:border-edupurple resize-none"></textarea>
          </div>
          <div class="flex justify-end gap-2">
            <button type="button" onclick="closeModal()" class="px-4 py-2 rounded-xl bg-edubg text-xs font-bold text-edumuted">Batal</button>
            <button type="submit" class="px-5 py-2 rounded-xl bg-amber-500 text-white text-xs font-bold shadow-sm">Buat Tugas Kelompok</button>
          </div>
        </form>
      `;
      openModal('Buat Tugas Kelompok Baru', html);
    }

    function handleConfirmCreateGroupTask(e, classId) {
      e.preventDefault();
      const title = document.getElementById('grp-title').value.trim();
      const dueDate = document.getElementById('grp-due').value;
      const instructions = document.getElementById('grp-inst').value.trim();

      const newGradeCol = {
        id: 'g_' + Date.now(),
        classId,
        title: title
      };
      appState.gradeColumns.push(newGradeCol);

      appState.assessments.push({
        id: 'ass_' + Date.now(),
        classId,
        type: 'group',
        title,
        dueDate,
        gradeColId: newGradeCol.id,
        instructions,
        submissions: {},
        comments: []
      });

      saveState();
      closeModal();
      showToast('Tugas Kelompok berhasil dibuat!');
      renderTeacherActiveTab();
    }

    function updateAssessmentGrade(assessmentId, studentId, scoreValue) {
      const ass = appState.assessments.find(a => a.id === assessmentId);
      if (!ass) return;

      if (!ass.submissions) ass.submissions = {};
      if (!ass.submissions[studentId]) {
        ass.submissions[studentId] = { submittedAt: 'Penilaian Langsung Guru' };
      }
      ass.submissions[studentId].score = scoreValue === '' ? null : Number(scoreValue);

      if (ass.gradeColId) {
        if (!appState.gradeScores[ass.classId]) appState.gradeScores[ass.classId] = {};
        if (!appState.gradeScores[ass.classId][studentId]) appState.gradeScores[ass.classId][studentId] = {};
        appState.gradeScores[ass.classId][studentId][ass.gradeColId] = scoreValue === '' ? null : Number(scoreValue);
      }

      saveState();
      showToast('Nilai tersimpan dan teragregasi otomatis ke Buku Nilai.');
    }

    function downloadSimulatedAnswer(studentName, title) {
      const textContent = `LEMBAR JAWABAN SISWA EDUMATE\nNama Siswa: ${studentName}\nTugas: ${title}\nTanggal Unduh: ${new Date().toLocaleString()}\n\nJawaban Butir Soal Esai:\n1. Pembahasan analisis fungsi kuadrat dan titik optimum kurva parabola.\n2. Titik puncak x = 2, f(2) = -2 sumbu simetri berada pada x = 2.\n\nStatus: Lengkap & Siap Dinilai.`;
      const blob = new Blob([textContent], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Jawaban_${studentName.replace(/\s+/g, '_')}.txt`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast('Berkas jawaban siswa berhasil diunduh!');
    }

    function handleDeleteAssessment(id) {
      appState.assessments = appState.assessments.filter(a => a.id !== id);
      saveState();
      showToast('Penugasan berhasil dihapus.');
      renderTeacherActiveTab();
    }
  </script>

