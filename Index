          <span class="text-[10px] text-edumuted">Pilih</span>
        </div>
      `).join('');
      resultsBox.classList.remove('hidden');
    }

    function selectStudentForPoint(id, name) {
      selectedStudentForPoint = { id, name };
      document.getElementById('pt-search').value = name;
      document.getElementById('pt-selected-name').innerText = name;
      const total = getStudentPoints(id);
      const sp = getStudentSPStatus(total);
      
      document.getElementById('pt-current-points').innerHTML = `
        <span class="inline-flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full ${sp.dotClass}"></span>
          <span>Poin: <strong>${total}</strong></span>
          ${sp.label ? `<span class="px-2 py-0.5 rounded-full text-[10px] font-black ${sp.badgeClass}">${sp.label}</span>` : ''}
        </span>
      `;
      document.getElementById('pt-selected-box').classList.remove('hidden');
      document.getElementById('pt-search-results').classList.add('hidden');
    }

    function handleSubmitStudentPoint(e) {
      e.preventDefault();
      const classId = document.getElementById('pt-class').value;
      if (!selectedStudentForPoint) {
        showToast('Pilih nama siswa dari hasil pencarian!', 'warning');
        return;
      }
      const points = Number(document.getElementById('pt-value').value);
      const date = document.getElementById('pt-date').value;
      const reason = document.getElementById('pt-reason').value.trim();

      appState.points.unshift({
        id: 'p_' + Date.now(),
        studentId: selectedStudentForPoint.id,
        studentName: selectedStudentForPoint.name,
        classId,
        points,
        reason,
        date
      });

      saveState();
      showToast(`Poin ${points > 0 ? '+' : ''}${points} berhasil dicatat untuk ${selectedStudentForPoint.name}!`);
      renderTeacherActiveTab();
    }
