    function handleClassChangeForPoint(classId) {
      selectedStudentForPoint = null;
      document.getElementById('pt-search').value = '';
      document.getElementById('pt-selected-box').classList.add('hidden');
    }

    function handleStudentSearchForPoint(query) {
      const classId = document.getElementById('pt-class').value;
      const resultsBox = document.getElementById('pt-search-results');
      if (!classId || !query.trim()) {
        resultsBox.classList.add('hidden');
        return;
      }

      const filtered = appState.students.filter(s => 
        s.classId === classId && 
        s.fullName.toLowerCase().includes(query.toLowerCase())
      );

      if (filtered.length === 0) {
        resultsBox.innerHTML = '<div class="p-3 text-xs text-edumuted">Tidak ada siswa yang cocok.</div>';
        resultsBox.classList.remove('hidden');
        return;
      }

      resultsBox.innerHTML = filtered.map(s => `
        <div onclick="selectStudentForPoint('${s.id}', '${s.fullName}')" class="p-3 hover:bg-edupurpleLight text-xs cursor-pointer border-b border-eduborder/50 flex justify-between items-center transition">
