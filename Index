      if (!ass.comments) ass.comments = [];
      const now = new Date();
      const dateStr = `${now.getHours()}:${String(now.getMinutes()).padStart(2,'0')}`;
      ass.comments.push({
        author: appState.currentUser.name,
        role: 'siswa',
        text,
        date: dateStr
      });
      saveState();
      renderStudentActiveTab();
    }
