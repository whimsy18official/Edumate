              <div class="bg-white rounded-4xl p-6 shadow-card border border-eduborder space-y-4">
                <div class="flex items-start justify-between">
                  <div>
                    <h5 class="text-base font-extrabold text-edutext">${m.title}</h5>
                    <span class="text-[11px] text-edumuted">Dipublikasikan pada ${m.date}</span>
                  </div>
                  <button onclick="handleDeleteMaterial('${m.id}')" class="text-edumuted hover:text-red-500 text-xs p-1" title="Hapus Materi">
                    <i class="fa-solid fa-trash-can"></i>
                  </button>
                </div>
                <p class="text-xs text-edutext leading-relaxed">${m.content}</p>

                ${m.link ? `
                  <div class="p-3 bg-edupurpleLight rounded-2xl border border-edupurple/20 flex items-center justify-between text-xs">
                    <div class="flex items-center gap-2 text-edupurple font-bold truncate">
                      <i class="fa-solid fa-arrow-up-right-from-square"></i>
                      <span class="truncate">${m.link}</span>
                    </div>
                    <a href="${m.link}" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded-xl bg-edupurple text-white font-bold text-xs shrink-0 shadow-sm">
                      Buka Tautan
                    </a>
                  </div>
                ` : ''}

                <div class="pt-4 border-t border-eduborder space-y-2.5">
                  <span class="text-xs font-bold text-edupurple flex items-center gap-1.5">
                    <i class="fa-solid fa-comments"></i> Kolom Diskusi Siswa (${m.comments.length})
                  </span>
                  
                  <div class="space-y-2 max-h-48 overflow-y-auto pr-1">
                    ${m.comments.map(c => `
                      <div class="bg-edubg rounded-2xl p-2.5 text-xs border border-eduborder">
                        <div class="flex justify-between items-center mb-0.5">
                          <span class="font-bold ${c.role === 'guru' ? 'text-edupurple' : 'text-edupinkDark'}">${c.author}</span>
                          <span class="text-[10px] text-edumuted">${c.date}</span>
                        </div>
                        <p class="text-edutext">${c.text}</p>
                      </div>
                    `).join('')}
                  </div>

                  <form onsubmit="handleAddMaterialComment(event, '${m.id}')" class="flex gap-2 pt-1">
                    <input type="text" name="matComment" required placeholder="Tulis komentar/tanggapan guru..." class="flex-1 px-3 py-2 bg-edubg rounded-xl border border-eduborder text-xs outline-none focus:border-edupurple">
                    <button type="submit" class="px-4 py-2 rounded-xl bg-edupurple text-white text-xs font-bold">Kirim</button>
                  </form>
                </div>
              </div>
            `).join('')}
          </div>
        </div>
      `;
    }

    function handleCreateMaterial(e, classId) {
      e.preventDefault();
      const title = document.getElementById('mat-title').value.trim();
      const link = document.getElementById('mat-link').value.trim();
      const content = document.getElementById('mat-content').value.trim();
      if (!title || !content) return;

      const now = new Date().toISOString().split('T')[0];
      appState.materials.unshift({
        id: 'm_' + Date.now(),
        classId,
        title,
        link,
        content,
        date: now,
        comments: []
      });
      saveState();
      showToast('Materi dan tautan berhasil diterbitkan!');
      renderTeacherActiveTab();
    }

    function handleDeleteMaterial(id) {
      appState.materials = appState.materials.filter(m => m.id !== id);
      saveState();
      showToast('Materi berhasil dihapus.');
      renderTeacherActiveTab();
    }

    function handleAddMaterialComment(e, matId) {
      e.preventDefault();
      const input = e.target.querySelector('input[name="matComment"]');
      const text = input.value.trim();
      if (!text) return;

      const mat = appState.materials.find(m => m.id === matId);
      if (!mat) return;

      const now = new Date();
      const dateStr = `${now.getHours()}:${String(now.getMinutes()).padStart(2,'0')}`;
      mat.comments.push({
        author: appState.teacherProfile.fullName,
        role: 'guru',
        text,
        date: dateStr
      });
      saveState();
      renderTeacherActiveTab();
    }
  </script>

  <script>
