                Belum ada kuis atau tugas untuk kelas Anda.
              </div>
            ` : classAssessments.map(ass => {
              const sub = ass.submissions ? ass.submissions[studentId] : null;
              const questionCount = ass.type === 'quiz_pg' ? (ass.questions?.length || 0) : (ass.type === 'quiz_essay' ? (ass.questions?.length || 1) : 0);

