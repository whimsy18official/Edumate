            <h3 class="text-xl font-extrabold text-edutext mb-6 flex items-center gap-2.5">
              <i class="fa-solid fa-user-gear text-edupurple"></i>
              <span>Biodata & Akun Guru</span>
            </h3>

            <div class="flex items-center gap-5 p-4 bg-edubg rounded-3xl border border-eduborder mb-6">
              <div class="relative w-20 h-20 rounded-full overflow-hidden border-2 border-edupurple bg-white shrink-0">
                <img id="preview-teacher-avatar" src="${appState.teacherProfile.avatar}" alt="Avatar" class="w-full h-full object-cover">
              </div>
              <div class="space-y-2 flex-1">
                <label class="block text-xs font-bold text-edutext">Ubah Foto Profil Guru</label>
                <div class="flex flex-wrap gap-2">
                  <label class="px-3.5 py-2 rounded-xl bg-edupurple text-white font-bold text-xs cursor-pointer hover:bg-[#6856EC] transition inline-flex items-center gap-1.5 shadow-sm">
                    <i class="fa-solid fa-upload"></i> Unggah Berkas Foto
                    <input type="file" id="prof-photo-file" accept="image/*" class="hidden" onchange="handleTeacherAvatarUpload(event)">
                  </label>
                  <input type="text" id="prof-photo-url" value="${appState.teacherProfile.avatar}" placeholder="Atau tautan URL foto online..." class="flex-1 min-w-[180px] px-3 py-1.5 bg-white rounded-xl border border-eduborder text-xs outline-none focus:border-edupurple" onchange="previewPhotoUrl(this.value)">
                </div>
              </div>
            </div>

            <form onsubmit="handleUpdateTeacherProfile(event)" class="space-y-4">
              <div>
                <label class="block text-xs font-bold text-edutext mb-1">Nama Lengkap & Gelar</label>
                <input type="text" id="prof-fullname" value="${appState.teacherProfile.fullName}" required class="w-full px-4 py-3 bg-edubg rounded-2xl border border-eduborder text-xs font-bold text-edutext outline-none focus:border-edupurple">
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold text-edutext mb-1">Nomor Induk Pegawai (NIP)</label>
                  <input type="text" id="prof-nip" value="${appState.teacherProfile.nip}" required class="w-full px-4 py-3 bg-edubg rounded-2xl border border-eduborder text-xs font-semibold text-edutext outline-none focus:border-edupurple">
                </div>
                <div>
                  <label class="block text-xs font-bold text-edutext mb-1">Username Login</label>
                  <input type="text" id="prof-username" value="${appState.teacherProfile.username}" required class="w-full px-4 py-3 bg-edubg rounded-2xl border border-eduborder text-xs font-semibold text-edutext outline-none focus:border-edupurple">
                </div>
              </div>

              <div>
                <label class="block text-xs font-bold text-edutext mb-1">Password Baru (Kosongkan jika tidak ingin diubah)</label>
                <input type="password" id="prof-password" placeholder="Ketik password baru..." class="w-full px-4 py-3 bg-edubg rounded-2xl border border-eduborder text-xs font-semibold text-edutext outline-none focus:border-edupurple">
              </div>

              <div>
                <label class="block text-xs font-bold text-edutext mb-1">Bio / Catatan Guru</label>
                <textarea id="prof-bio" rows="3" class="w-full px-4 py-3 bg-edubg rounded-2xl border border-eduborder text-xs font-medium text-edutext outline-none focus:border-edupurple resize-none">${appState.teacherProfile.bio}</textarea>
              </div>

              <div class="pt-4 flex justify-end">
                <button type="submit" class="px-6 py-3.5 rounded-2xl bg-edupurple hover:bg-[#6856EC] text-white font-bold text-xs shadow-clay transition flex items-center gap-2">
                  <i class="fa-solid fa-floppy-disk"></i>
                  <span>Simpan Perubahan Profil</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      `;
    }

    function previewPhotoUrl(url) {
      if (url) {
        document.getElementById('preview-teacher-avatar').src = url;
      }
    }

    function handleTeacherAvatarUpload(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(evt) {
        const dataUrl = evt.target.result;
        document.getElementById('preview-teacher-avatar').src = dataUrl;
        document.getElementById('prof-photo-url').value = dataUrl;
      };
      reader.readAsDataURL(file);
    }

    function handleUpdateTeacherProfile(e) {
      e.preventDefault();
      const fullName = document.getElementById('prof-fullname').value.trim();
      const nip = document.getElementById('prof-nip').value.trim();
      const username = document.getElementById('prof-username').value.trim();
      const password = document.getElementById('prof-password').value.trim();
      const bio = document.getElementById('prof-bio').value.trim();
      const avatar = document.getElementById('prof-photo-url').value.trim();

      appState.teacherProfile.fullName = fullName;
      appState.teacherProfile.nip = nip;
      appState.teacherProfile.username = username;
      if (avatar) appState.teacherProfile.avatar = avatar;
      if (password) {
        appState.teacherProfile.password = password;
      }
      appState.teacherProfile.bio = bio;
      appState.currentUser.name = fullName;
      appState.currentUser.username = username;

      saveState();
      showToast('Profil dan foto guru berhasil diperbarui!');
      renderApp();
    }
  </script>

  <script>
    function renderTeacherStudentManagement(container) {
      container.innerHTML = `
        <div class="space-y-6">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <!-- Buat Kelas Baru -->
            <div class="lg:col-span-5 space-y-5">
              <div class="bg-white rounded-4xl p-6 shadow-card border border-eduborder">
                <h3 class="font-extrabold text-base text-edutext mb-4 flex items-center gap-2">
                  <i class="fa-solid fa-folder-plus text-edupinkDark"></i>
                  <span>Buat Kelas Baru</span>
                </h3>

                <form onsubmit="handleCreateClass(event)" class="space-y-3">
                  <div>
                    <label class="block text-xs font-bold text-edutext mb-1">Nama Kelas</label>
                    <input type="text" id="new-class-name" required placeholder="Contoh: X-MIPA-3" class="w-full px-4 py-2.5 bg-edubg rounded-2xl border border-eduborder text-xs font-bold text-edutext outline-none focus:border-edupurple">
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-edutext mb-1">Mata Pelajaran</label>
                    <input type="text" id="new-class-subject" required placeholder="Contoh: Matematika Peminatan" class="w-full px-4 py-2.5 bg-edubg rounded-2xl border border-eduborder text-xs font-semibold text-edutext outline-none focus:border-edupurple">
                  </div>
                  <button type="submit" class="w-full py-3 bg-edupink hover:bg-edupinkDark text-white text-xs font-bold rounded-2xl shadow-soft transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-plus"></i>
                    <span>Tambahkan Kelas</span>
                  </button>
                </form>

                <div class="mt-6 pt-5 border-t border-eduborder">
                  <h4 class="text-xs font-bold text-edumuted uppercase tracking-wider mb-3">Daftar Kelas Aktif (${appState.classes.length})</h4>
                  <div class="space-y-2">
                    ${appState.classes.map(c => {
                      const count = appState.students.filter(s => s.classId === c.id).length;
                      return `
                        <div class="flex items-center justify-between p-3 rounded-2xl bg-edubg border border-eduborder text-xs">
                          <div>
                            <div class="font-bold text-edutext">${c.name}</div>
                            <div class="text-[11px] text-edumuted">${c.subject} • ${count} Siswa</div>
                          </div>
                          <button onclick="handleDeleteClass('${c.id}')" class="w-8 h-8 rounded-xl bg-white hover:bg-red-50 text-edumuted hover:text-red-500 transition flex items-center justify-center shadow-sm" title="Hapus Kelas">
                            <i class="fa-solid fa-trash-can text-xs"></i>
                          </button>
                        </div>
                      `;
                    }).join('')}
                  </div>
                </div>

              </div>
            </div>

            <!-- Masukkan Siswa Massal -->
            <div class="lg:col-span-7 space-y-5">
              <div class="bg-white rounded-4xl p-6 shadow-card border border-eduborder">
                <div class="flex items-center justify-between mb-4">
                  <h3 class="font-extrabold text-base text-edutext flex items-center gap-2">
                    <i class="fa-solid fa-user-plus text-edupurple"></i>
                    <span>Pendaftaran Siswa Massal</span>
                  </h3>
                  <span class="text-xs font-semibold text-edupurple bg-edupurpleLight px-3 py-1 rounded-full">Enter per Baris</span>
                </div>
                <p class="text-xs text-edumuted mb-4">
                  Siswa yang dimasukkan otomatis dibuatkan akun dengan kata sandi awal <strong class="text-edupurple font-mono">123456</strong>.
                </p>

                <form onsubmit="handleBulkAddStudents(event)" class="space-y-4">
                  <div>
                    <label class="block text-xs font-bold text-edutext mb-1">Target Kelas</label>
                    <select id="bulk-target-class" required class="w-full px-4 py-2.5 bg-edubg rounded-2xl border border-eduborder text-xs font-bold text-edutext outline-none focus:border-edupurple cursor-pointer">
                      <option value="" disabled selected>Pilih kelas target</option>
                      ${appState.classes.map(c => `<option value="${c.id}">${c.name} - ${c.subject}</option>`).join('')}
                    </select>
                  </div>

                  <div>
                    <label class="block text-xs font-bold text-edutext mb-1">Daftar Nama Siswa (Satu nama per baris)</label>
                    <textarea id="bulk-student-names" required rows="6" placeholder="Ahmad Firdaus&#10;Bella Safitri&#10;Chairul Anwar&#10;Dewi Lestari" class="w-full px-4 py-3 bg-edubg rounded-2xl border border-eduborder text-xs font-medium text-edutext outline-none focus:border-edupurple resize-y"></textarea>
                  </div>

                  <button type="submit" class="w-full py-3.5 bg-edupurple hover:bg-[#6856EC] text-white text-xs font-bold rounded-2xl shadow-clay transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-file-import"></i>
                    <span>Daftarkan Semua Siswa Sekaligus</span>
                  </button>
                </form>

                <div class="mt-6 pt-5 border-t border-eduborder">
                  <div class="flex items-center justify-between mb-3">
                    <h4 class="text-xs font-bold text-edumuted uppercase tracking-wider">Total Siswa Terdaftar: ${appState.students.length}</h4>
                  </div>
                  <div class="max-h-56 overflow-y-auto space-y-1.5 pr-1">
                    ${appState.students.map(s => {
                      const c = appState.classes.find(cl => cl.id === s.classId);
                      return `
                        <div class="flex items-center justify-between px-3 py-2 bg-edubg rounded-xl text-xs">
                          <div>
                            <span class="font-bold text-edutext">${s.fullName}</span>
                            <span class="text-[10px] text-edumuted ml-2">(${c ? c.name : 'Tanpa Kelas'})</span>
                          </div>
                          <button onclick="handleDeleteStudent('${s.id}')" class="text-edumuted hover:text-red-500 text-xs" title="Hapus Siswa">
                            <i class="fa-solid fa-trash-can"></i>
                          </button>
                        </div>
                      `;
                    }).join('')}
                  </div>
                </div>

              </div>
            </div>

          </div>
        </div>
      `;
    }

    function handleCreateClass(e) {
      e.preventDefault();
      const name = document.getElementById('new-class-name').value.trim();
      const subject = document.getElementById('new-class-subject').value.trim();
      if (!name || !subject) return;

      const newClass = {
        id: 'c_' + Date.now(),
        name,
        subject
      };
      appState.classes.push(newClass);
      saveState();
      showToast(`Kelas ${name} berhasil dibuat!`);
      renderTeacherActiveTab();
    }

    function handleDeleteClass(id) {
      const cls = appState.classes.find(c => c.id === id);
      if (!cls) return;
      
      appState.classes = appState.classes.filter(c => c.id !== id);
      appState.students = appState.students.filter(s => s.classId !== id);
      saveState();
      showToast(`Kelas ${cls.name} dan siswa di dalamnya telah dihapus.`, 'warning');
      renderTeacherActiveTab();
    }

    function handleBulkAddStudents(e) {
      e.preventDefault();
      const classId = document.getElementById('bulk-target-class').value;
      const rawText = document.getElementById('bulk-student-names').value;
      if (!classId || !rawText.trim()) return;

      const names = rawText.split('\n').map(n => n.trim()).filter(n => n.length > 0);
      if (names.length === 0) return;

      let addedCount = 0;
      names.forEach(fullName => {
        const username = fullName.toLowerCase().replace(/[^a-z0-9]/g, '_') + '_' + Math.floor(Math.random()*100);
        appState.students.push({
          id: 's_' + Date.now() + '_' + Math.random().toString(36).substr(2, 4),
          fullName,
          username,
          classId,
          password: '123456',
          mustChange: true,
          lastLogin: null
        });
        addedCount++;
      });

      saveState();
      showToast(`Berhasil menambahkan ${addedCount} siswa dengan kata sandi awal 123456!`);
      renderTeacherActiveTab();
    }

    function handleDeleteStudent(id) {
      appState.students = appState.students.filter(s => s.id !== id);
      saveState();
      showToast('Data siswa berhasil dihapus.');
      renderTeacherActiveTab();
    }
  </script>

  <script>
    let classActiveSubTab = 'absensi';

    function renderTeacherClassExplorer(container) {
      if (!selectedClassId) {
        container.innerHTML = `
          <div class="space-y-6">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-xl font-extrabold text-edutext">Pilih Kelas untuk Dikelola</h3>
                <p class="text-xs text-edumuted">Klik pada salah satu kartu kelas untuk mengelola absensi, buku nilai, katrol rapot, materi, kuis, dan tugas.</p>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              ${appState.classes.map(c => {
                const studentCount = appState.students.filter(s => s.classId === c.id).length;
                return `
                  <div onclick="selectClass('${c.id}')" class="bg-white hover:bg-edubg/50 rounded-4xl p-6 shadow-card border border-eduborder hover:border-edupurple transition-all duration-300 cursor-pointer group flex flex-col justify-between h-56">
                    <div>
                      <div class="flex items-center justify-between mb-4">
                        <span class="px-3 py-1 rounded-full bg-edupurpleLight text-edupurple text-xs font-bold">
                          ${c.subject}
                        </span>
                        <div class="w-8 h-8 rounded-full bg-edubg group-hover:bg-edupurple group-hover:text-white text-edumuted flex items-center justify-center transition">
                          <i class="fa-solid fa-arrow-right text-xs"></i>
                        </div>
                      </div>
                      <h4 class="text-xl font-extrabold text-edutext mb-1">${c.name}</h4>
                      <p class="text-xs text-edumuted font-medium">${studentCount} Siswa terdaftar</p>
                    </div>

                    <div class="pt-4 border-t border-eduborder flex items-center justify-between text-xs text-edumuted">
                      <span>Kelola Akademik</span>
                      <span class="font-bold text-edupurple flex items-center gap-1">Buka Kelas <i class="fa-solid fa-chevron-right text-[10px]"></i></span>
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        `;
        return;
      }

      const currentClass = appState.classes.find(c => c.id === selectedClassId);
      if (!currentClass) {
        selectedClassId = null;
        renderTeacherActiveTab();
        return;
      }

      const classStudents = appState.students.filter(s => s.classId === selectedClassId);

      container.innerHTML = `
        <div class="space-y-6">
          <div class="bg-white rounded-3xl p-5 shadow-card border border-eduborder flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
              <button onclick="deselectClass()" class="w-10 h-10 rounded-2xl bg-edubg hover:bg-edupurple hover:text-white text-edutext transition flex items-center justify-center shadow-sm">
                <i class="fa-solid fa-arrow-left"></i>
              </button>
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="text-lg font-extrabold text-edutext">${currentClass.name}</h3>
                  <span class="text-xs font-bold text-edupurple bg-edupurpleLight px-2.5 py-0.5 rounded-full">${currentClass.subject}</span>
                </div>
                <p class="text-xs text-edumuted">${classStudents.length} Siswa Terdaftar</p>
              </div>
            </div>

            <div class="flex flex-wrap items-center bg-edubg p-1.5 rounded-2xl border border-eduborder gap-1">
              ${renderSubTabButton('absensi', 'Absensi', 'fa-calendar-check')}
              ${renderSubTabButton('nilai', 'Nilai Siswa', 'fa-chart-simple')}
              ${renderSubTabButton('rekap', 'Rekap & Katrol', 'fa-calculator')}
              ${renderSubTabButton('materi', 'Materi', 'fa-book-open')}
              ${renderSubTabButton('tugas', 'Tugas & Quiz', 'fa-list-check')}
            </div>
          </div>

          <div id="class-subcontent" class="w-full"></div>
        </div>
      `;

      renderClassSubContent(currentClass, classStudents);
    }

    function renderSubTabButton(subTabId, label, icon) {
      const isActive = classActiveSubTab === subTabId;
      const activeClass = isActive 
        ? 'bg-edupurple text-white shadow-sm' 
        : 'text-edumuted hover:text-edutext';
      return `
        <button onclick="setClassSubTab('${subTabId}')" class="px-3.5 py-2 rounded-xl text-xs font-bold transition flex items-center gap-1.5 ${activeClass}">
          <i class="fa-solid ${icon}"></i>
          <span>${label}</span>
        </button>
      `;
    }

    function selectClass(id) {
      selectedClassId = id;
      classActiveSubTab = 'absensi';
      renderTeacherActiveTab();
    }

    function deselectClass() {
      selectedClassId = null;
      renderTeacherActiveTab();
    }

    function setClassSubTab(tab) {
      classActiveSubTab = tab;
      renderTeacherActiveTab();
    }

    function renderClassSubContent(currentClass, classStudents) {
      const container = document.getElementById('class-subcontent');
      if (!container) return;

      switch (classActiveSubTab) {
        case 'absensi':
          renderClassAttendance(container, currentClass, classStudents);
          break;
        case 'nilai':
          renderClassGrades(container, currentClass, classStudents);
          break;
        case 'rekap':
          renderClassRekapKatrol(container, currentClass, classStudents);
          break;
        case 'materi':
          renderClassMaterials(container, currentClass);
          break;
        case 'tugas':
          renderClassAssessments(container, currentClass, classStudents);
          break;
      }
    }
  </script>

  <script>
    function renderClassAttendance(container, currentClass, classStudents) {
      const today = new Date().toISOString().split('T')[0];
      let attendanceToday = appState.attendances.find(a => a.classId === currentClass.id && a.date === today);

      if (!attendanceToday) {
        attendanceToday = {
          classId: currentClass.id,
          date: today,
          records: {}
        };
        classStudents.forEach(st => {
          attendanceToday.records[st.id] = 'hadir';
        });
        appState.attendances.push(attendanceToday);
        saveState();
      }

      container.innerHTML = `
        <div class="bg-white rounded-4xl p-6 shadow-card border border-eduborder space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h4 class="font-extrabold text-base text-edutext flex items-center gap-2">
                <i class="fa-solid fa-calendar-check text-emerald-500"></i>
                <span>Presensi Siswa Harian</span>
              </h4>
              <p class="text-xs text-edumuted">Tanggal pertemuan: <strong class="text-edutext font-semibold">${today}</strong></p>
            </div>
            <button onclick="handleSaveAttendance('${currentClass.id}', '${today}')" class="px-5 py-2.5 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-sm transition flex items-center gap-2">
              <i class="fa-solid fa-check-double"></i>
              <span>Simpan Presensi Hari Ini</span>
            </button>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead>
                <tr class="bg-edubg text-edumuted uppercase tracking-wider text-[11px] font-bold">
                  <th class="p-3.5 rounded-l-2xl">No</th>
                  <th class="p-3.5">Nama Siswa</th>
                  <th class="p-3.5 text-center">Hadir</th>
                  <th class="p-3.5 text-center">Sakit</th>
                  <th class="p-3.5 text-center">Izin</th>
                  <th class="p-3.5 text-center rounded-r-2xl">Alpa</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-eduborder">
                ${classStudents.map((st, idx) => {
                  const status = attendanceToday.records[st.id] || 'hadir';
                  return `
                    <tr class="hover:bg-edubg/40 transition">
                      <td class="p-3.5 font-bold text-edumuted">${idx + 1}</td>
                      <td class="p-3.5 font-bold text-edutext">${st.fullName}</td>
                      <td class="p-3.5 text-center">
                        <input type="radio" name="att_${st.id}" value="hadir" ${status === 'hadir' ? 'checked' : ''} onchange="updateAttendanceRecord('${currentClass.id}', '${today}', '${st.id}', 'hadir')" class="accent-emerald-600 w-4 h-4 cursor-pointer">
                      </td>
                      <td class="p-3.5 text-center">
                        <input type="radio" name="att_${st.id}" value="sakit" ${status === 'sakit' ? 'checked' : ''} onchange="updateAttendanceRecord('${currentClass.id}', '${today}', '${st.id}', 'sakit')" class="accent-yellow-500 w-4 h-4 cursor-pointer">
                      </td>
                      <td class="p-3.5 text-center">
                        <input type="radio" name="att_${st.id}" value="izin" ${status === 'izin' ? 'checked' : ''} onchange="updateAttendanceRecord('${currentClass.id}', '${today}', '${st.id}', 'izin')" class="accent-blue-500 w-4 h-4 cursor-pointer">
                      </td>
                      <td class="p-3.5 text-center">
                        <input type="radio" name="att_${st.id}" value="alpa" ${status === 'alpa' ? 'checked' : ''} onchange="updateAttendanceRecord('${currentClass.id}', '${today}', '${st.id}', 'alpa')" class="accent-red-500 w-4 h-4 cursor-pointer">
                      </td>
                    </tr>
                  `;
                }).join('')}
              </tbody>
            </table>
          </div>
        </div>
      `;
    }

    function updateAttendanceRecord(classId, date, studentId, status) {
      const att = appState.attendances.find(a => a.classId === classId && a.date === date);
      if (att) {
        att.records[studentId] = status;
        saveState();
      }
    }

    function handleSaveAttendance(classId, date) {
      saveState();
      showToast('Data presensi pertemuan berhasil disimpan!');
    }

    function renderClassGrades(container, currentClass, classStudents) {
      const cols = appState.gradeColumns.filter(c => c.classId === currentClass.id);
      if (!appState.gradeScores[currentClass.id]) {
        appState.gradeScores[currentClass.id] = {};
      }

      container.innerHTML = `
        <div class="bg-white rounded-4xl p-6 shadow-card border border-eduborder space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h4 class="font-extrabold text-base text-edutext flex items-center gap-2">
                <i class="fa-solid fa-chart-simple text-edupurple"></i>
                <span>Buku Nilai & Komponen Penilaian</span>
              </h4>
              <p class="text-xs text-edumuted">Rata-rata, predikat grade, dan nilai bulat otomatis terhitung.</p>
            </div>
            <button onclick="promptAddGradeColumn('${currentClass.id}')" class="px-4 py-2.5 rounded-2xl bg-edupurple hover:bg-[#6856EC] text-white text-xs font-bold shadow-clay transition flex items-center gap-2">
              <i class="fa-solid fa-plus"></i>
              <span>Tambah Kolom Nilai</span>
            </button>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs min-w-[700px]">
              <thead>
                <tr class="bg-edubg text-edumuted uppercase tracking-wider text-[11px] font-bold">
                  <th class="p-3.5 rounded-l-2xl">Nama Siswa</th>
                  ${cols.map(c => `
                    <th class="p-3.5 text-center">
                      <div class="flex items-center justify-center gap-1.5">
                        <span>${c.title}</span>
                        <button onclick="handleDeleteGradeCol('${c.id}')" class="text-edumuted hover:text-red-500 text-[10px]" title="Hapus Kolom">
                          <i class="fa-solid fa-xmark"></i>
                        </button>
                      </div>
                    </th>
                  `).join('')}
                  <th class="p-3.5 text-center bg-edupurpleLight text-edupurple">Rata-Rata</th>
                  <th class="p-3.5 text-center bg-edupinkSoft text-edupinkDark">Grade</th>
                  <th class="p-3.5 text-center rounded-r-2xl bg-emerald-50 text-emerald-700">Nilai Akhir Bulat</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-eduborder">
                ${classStudents.map(st => {
                  const avg = calculateStudentAverage(currentClass.id, st.id);
                  const rounded = Math.round(avg);
                  const grade = getLetterGrade(rounded);
                  const studentScores = appState.gradeScores[currentClass.id][st.id] || {};

                  return `
                    <tr class="hover:bg-edubg/30 transition">
                      <td class="p-3.5 font-bold text-edutext">${st.fullName}</td>
                      ${cols.map(col => {
                        const val = studentScores[col.id] !== undefined ? studentScores[col.id] : '';
                        return `
                          <td class="p-2 text-center">
                            <input type="number" min="0" max="100" value="${val}" onchange="updateStudentScore('${currentClass.id}', '${st.id}', '${col.id}', this.value)" class="w-16 px-2 py-1.5 text-center font-bold text-xs bg-edubg rounded-xl border border-eduborder focus:border-edupurple outline-none">
                          </td>
                        `;
                      }).join('')}
                      <td class="p-3.5 text-center font-extrabold text-edupurple">${avg.toFixed(1)}</td>
                      <td class="p-3.5 text-center">
                        <span class="inline-block px-2.5 py-1 rounded-xl text-xs font-black ${grade === 'A' ? 'bg-emerald-100 text-emerald-700' : grade === 'B' ? 'bg-blue-100 text-blue-700' : grade === 'C' ? 'bg-yellow-100 text-yellow-700' : 'bg-red-100 text-red-700'}">
                          ${grade}
                        </span>
                      </td>
                      <td class="p-3.5 text-center font-extrabold text-emerald-700 text-sm">${rounded}</td>
                    </tr>
                  `;
                }).join('')}
              </tbody>
            </table>
          </div>
        </div>
      `;
    }

    function promptAddGradeColumn(classId) {
      const html = `
        <div class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-edutext mb-1">Judul Komponen Nilai</label>
            <input type="text" id="new-grade-title" placeholder="Contoh: Tugas 2, UTS, Praktik" class="w-full px-4 py-2.5 bg-edubg rounded-2xl border border-eduborder text-xs font-bold text-edutext outline-none focus:border-edupurple">
          </div>
          <div class="flex justify-end gap-2">
            <button onclick="closeModal()" class="px-4 py-2 rounded-xl bg-edubg text-xs font-bold text-edumuted">Batal</button>
            <button onclick="confirmAddGradeColumn('${classId}')" class="px-5 py-2 rounded-xl bg-edupurple text-white text-xs font-bold shadow-clay">Tambah</button>
          </div>
        </div>
      `;
      openModal('Tambah Kolom Nilai Baru', html);
    }

    function confirmAddGradeColumn(classId) {
      const title = document.getElementById('new-grade-title').value.trim();
      if (!title) return;

      const newCol = {
        id: 'g_' + Date.now(),
        classId,
        title
      };
      appState.gradeColumns.push(newCol);
      saveState();
      closeModal();
      showToast(`Kolom penilaian "${title}" ditambahkan!`);
      renderTeacherActiveTab();
    }

    function handleDeleteGradeCol(colId) {
      appState.gradeColumns = appState.gradeColumns.filter(c => c.id !== colId);
      saveState();
      showToast('Kolom nilai dihapus.');
      renderTeacherActiveTab();
    }

    function updateStudentScore(classId, studentId, colId, value) {
      if (!appState.gradeScores[classId]) appState.gradeScores[classId] = {};
      if (!appState.gradeScores[classId][studentId]) appState.gradeScores[classId][studentId] = {};
      
      appState.gradeScores[classId][studentId][colId] = value === '' ? null : Number(value);
      saveState();
      renderTeacherActiveTab();
    }

    function renderClassRekapKatrol(container, currentClass, classStudents) {
      const currentKatrol = appState.katrolSettings[currentClass.id] || 0;

      container.innerHTML = `
        <div class="bg-white rounded-4xl p-6 shadow-card border border-eduborder space-y-6">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
              <h4 class="font-extrabold text-base text-edutext flex items-center gap-2">
                <i class="fa-solid fa-calculator text-edupinkDark"></i>
                <span>Rekapitulasi Nilai & Fasilitas Katrol Rapor</span>
              </h4>
              <p class="text-xs text-edumuted">Terapkan penyesuaian nilai katrol secara serentak untuk seluruh siswa kelas.</p>
            </div>

            <div class="flex items-center gap-3 bg-edubg p-2 rounded-2xl border border-eduborder">
              <span class="text-xs font-bold text-edutext ml-2">Poin Katrol:</span>
              <input type="number" id="katrol-input" value="${currentKatrol}" class="w-16 px-2.5 py-1.5 text-center font-bold text-xs bg-white rounded-xl border border-eduborder focus:border-edupurple outline-none">
              <button onclick="handleApplyKatrol('${currentClass.id}')" class="px-4 py-2 rounded-xl bg-edupink hover:bg-edupinkDark text-white text-xs font-bold shadow-soft transition">
                Terapkan Katrol
              </button>
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs min-w-[650px]">
              <thead>
                <tr class="bg-edubg text-edumuted uppercase tracking-wider text-[11px] font-bold">
                  <th class="p-3.5 rounded-l-2xl">No</th>
                  <th class="p-3.5">Nama Siswa</th>
                  <th class="p-3.5 text-center">Rata-Rata Asli</th>
                  <th class="p-3.5 text-center text-edupinkDark">Penyesuaian Katrol</th>
                  <th class="p-3.5 text-center bg-edupurpleLight text-edupurple">Nilai Rapor Akhir</th>
                  <th class="p-3.5 text-center rounded-r-2xl">Predikat Rapor</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-eduborder">
                ${classStudents.map((st, idx) => {
                  const rawAvg = calculateStudentAverage(currentClass.id, st.id);
                  const finalScore = getKatrolFinalScore(currentClass.id, st.id);
                  const grade = getLetterGrade(finalScore);

                  return `
                    <tr class="hover:bg-edubg/30 transition">
                      <td class="p-3.5 font-bold text-edumuted">${idx + 1}</td>
                      <td class="p-3.5 font-bold text-edutext">${st.fullName}</td>
                      <td class="p-3.5 text-center font-semibold text-edumuted">${rawAvg.toFixed(1)}</td>
                      <td class="p-3.5 text-center font-bold text-edupinkDark">+${currentKatrol}</td>
                      <td class="p-3.5 text-center font-black text-edupurple text-sm">${finalScore}</td>
                      <td class="p-3.5 text-center font-bold">
                        <span class="px-2.5 py-1 rounded-xl text-xs font-extrabold ${grade === 'A' ? 'bg-emerald-100 text-emerald-700' : grade === 'B' ? 'bg-blue-100 text-blue-700' : grade === 'C' ? 'bg-yellow-100 text-yellow-700' : 'bg-red-100 text-red-700'}">
                          ${grade}
                        </span>
                      </td>
                    </tr>
                  `;
                }).join('')}
              </tbody>
            </table>
          </div>
        </div>
      `;
    }

    function handleApplyKatrol(classId) {
      const val = Number(document.getElementById('katrol-input').value) || 0;
      appState.katrolSettings[classId] = val;
      saveState();
      showToast(`Nilai katrol sebesar +${val} poin berhasil diterapkan ke rapor!`);
      renderTeacherActiveTab();
    }
  </script>

  <script>
    function renderClassMaterials(container, currentClass) {
      const classMaterials = appState.materials.filter(m => m.classId === currentClass.id);

      container.innerHTML = `
        <div class="space-y-6">
          <div class="bg-white rounded-4xl p-6 shadow-card border border-eduborder">
            <h4 class="font-extrabold text-base text-edutext mb-4 flex items-center gap-2">
              <i class="fa-solid fa-cloud-arrow-up text-edupurple"></i>
              <span>Unggah Materi Pembelajaran Baru</span>
            </h4>

            <form onsubmit="handleCreateMaterial(event, '${currentClass.id}')" class="space-y-3">
              <input type="text" id="mat-title" required placeholder="Judul Materi Pembelajaran..." class="w-full px-4 py-2.5 bg-edubg rounded-2xl border border-eduborder text-xs font-bold outline-none focus:border-edupurple">
              <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-edumuted text-xs"><i class="fa-solid fa-link"></i></span>
                <input type="url" id="mat-link" placeholder="Tautan Materi / Referensi (YouTube, Google Drive, Website dll)..." class="w-full pl-9 pr-4 py-2 bg-edubg rounded-2xl border border-eduborder text-xs font-medium outline-none focus:border-edupurple">
              </div>
              <textarea id="mat-content" required rows="3" placeholder="Tuliskan isi ringkasan materi atau instruksi bacaan..." class="w-full px-4 py-2.5 bg-edubg rounded-2xl border border-eduborder text-xs font-medium outline-none focus:border-edupurple resize-none"></textarea>
              <div class="flex justify-end">
                <button type="submit" class="px-5 py-2.5 rounded-2xl bg-edupurple hover:bg-[#6856EC] text-white text-xs font-bold shadow-clay transition flex items-center gap-1.5">
                  <i class="fa-solid fa-plus"></i>
                  <span>Terbitkan Materi</span>
                </button>
              </div>
            </form>
          </div>

          <div class="space-y-4">
            ${classMaterials.length === 0 ? `
              <div class="bg-white rounded-3xl p-8 text-center text-xs text-edumuted border border-eduborder">
                Belum ada materi pelajaran yang diunggah untuk kelas ini.
              </div>
