    function handleSubmitStudentGroup(e, assessmentId) {
      e.preventDefault();
      const ass = appState.assessments.find(a => a.id === assessmentId);
      if (!ass) return;

      const groupName = document.getElementById('grp-name-input').value.trim();
      const studentId = appState.currentUser.id;

      if (!ass.submissions) ass.submissions = {};
      ass.submissions[studentId] = {
        groupName,
        submittedAt: new Date().toISOString()
      };

      saveState();
      closeModal();
      showToast('Tugas kelompok berhasil dikumpulkan!');
      renderStudentActiveTab();
    }

    function handleStudentAddAssessmentComment(e, assId) {
      e.preventDefault();
      const input = e.target.querySelector('input[name="stTaskComment"]');
      const text = input.value.trim();
