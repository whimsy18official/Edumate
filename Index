          </div>
        </form>
      `;
      openModal('Pengerjaan Quiz Pilihan Ganda Berwaktu', html);
      startQuizTimer(duration, () => {
        const form = document.getElementById('student-pg-form');
        if (form) form.requestSubmit();
      });
    }

    function renderStudentSubmitEssayModal(ass) {
      const duration = ass.durationMinutes || 30;
      const questions = ass.questions || [ass.question || 'Jawab pertanyaan esai berikut.'];
      const html = `
        <form id="student-essay-form" onsubmit="handleSubmitStudentEssay(event, '${ass.id}')" class="space-y-4">
          <div class="flex items-center justify-between p-3 bg-edupinkSoft rounded-2xl border border-edupink/20">
            <div class="text-xs font-bold text-edupinkDark">${ass.title} (${questions.length} Butir Soal)</div>
            <div class="flex items-center gap-1.5 text-xs font-bold text-edupinkDark bg-white px-3 py-1 rounded-xl shadow-sm">
              <i class="fa-solid fa-stopwatch"></i>
              <span id="quiz-timer-display">--:--</span>
            </div>
          </div>
          
          <div class="space-y-4 max-h-80 overflow-y-auto pr-1">
            ${questions.map((q, idx) => `
              <div class="p-3.5 bg-edubg rounded-2xl border border-eduborder space-y-2 text-xs">
                <div class="font-bold text-edutext">${idx + 1}. ${q}</div>
                <textarea name="essay_ans_${idx}" required rows="3" placeholder="Ketik jawaban esai untuk nomor ${idx + 1} di sini..." class="w-full px-3 py-2 bg-white rounded-xl border border-eduborder text-xs outline-none focus:border-edupurple resize-none"></textarea>
              </div>
            `).join('')}
          </div>

          <div class="flex justify-end gap-2 pt-2 border-t border-eduborder">
            <button type="button" onclick="closeQuizModalWithConfirm()" class="px-4 py-2 rounded-xl bg-edubg text-xs font-bold text-edumuted">Batal</button>
            <button type="submit" class="px-5 py-2 rounded-xl bg-edupink text-white text-xs font-bold shadow-soft">Kirim Jawaban Esai</button>
          </div>
        </form>
      `;
      openModal('Pengumpulan Kuis Esai Berwaktu', html);
      startQuizTimer(duration, () => {
        const form = document.getElementById('student-essay-form');
        if (form) form.requestSubmit();
      });
    }

    function handleSubmitStudentQuizPG(e, assessmentId) {
      e.preventDefault();
      if (quizTimerInterval) {
        clearInterval(quizTimerInterval);
        quizTimerInterval = null;
      }
      const ass = appState.assessments.find(a => a.id === assessmentId);
      if (!ass) return;

      const studentId = appState.currentUser.id;
      let correctCount = 0;
      const userAnswers = [];

      ass.questions.forEach(q => {
        const selected = e.target.querySelector(`input[name="q_${q.id}"]:checked`);
        const ans = selected ? Number(selected.value) : -1;
        userAnswers.push(ans);
        if (ans === q.correct) correctCount++;
      });

      const totalQ = ass.questions.length || 1;
      const score = Math.round((correctCount / totalQ) * 100);

      if (!ass.submissions) ass.submissions = {};
      ass.submissions[studentId] = {
        answers: userAnswers,
        score,
        submittedAt: new Date().toISOString()
      };

      if (ass.gradeColId) {
        if (!appState.gradeScores[ass.classId]) appState.gradeScores[ass.classId] = {};
        if (!appState.gradeScores[ass.classId][studentId]) appState.gradeScores[ass.classId][studentId] = {};
        appState.gradeScores[ass.classId][studentId][ass.gradeColId] = score;
      }

      saveState();
      closeModal();
      showToast('Kuis PG berhasil dikirim dan otomatis dinilai!');
      renderStudentActiveTab();
    }

    function handleSubmitStudentEssay(e, assessmentId) {
      e.preventDefault();
      if (quizTimerInterval) {
        clearInterval(quizTimerInterval);
        quizTimerInterval = null;
      }
      const ass = appState.assessments.find(a => a.id === assessmentId);
      if (!ass) return;

      const questions = ass.questions || [ass.question || ''];
      const answers = [];
      questions.forEach((_, idx) => {
        const el = e.target.querySelector(`textarea[name="essay_ans_${idx}"]`);
        answers.push(el ? el.value.trim() : '');
      });

      const studentId = appState.currentUser.id;
      if (!ass.submissions) ass.submissions = {};
      ass.submissions[studentId] = {
        answers,
        contentSnippet: answers.join(' | '),
        fileName: `Jawaban_${appState.currentUser.name.replace(/\s+/g,'_')}.txt`,
        submittedAt: new Date().toISOString()
      };

      saveState();
      closeModal();
      showToast('Jawaban kuis esai berhasil dikumpulkan!');
      renderStudentActiveTab();
    }
  </script>

