    let appState = loadState();

    function loadState() {
      try {
        const stored = sessionStorage.getItem(STORAGE_KEY);
        if (stored) return JSON.parse(stored);
      } catch (e) {
        console.error('Error loading stored state', e);
      }
      return JSON.parse(JSON.stringify(defaultState));
    }

    function saveState() {
      try {
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
      } catch (e) {
        console.error('Error saving state', e);
      }
      // Sinkronisasi otomatis ke Supabase di latar belakang
      syncStateToSupabase();
    }

    // Fungsi Pengaturan Kredensial Supabase
    function promptSupabaseConfig() {
      const html = `
        <form onsubmit="handleSaveSupabaseConfig(event)" class="space-y-4">
          <div class="p-3 bg-edupurpleLight rounded-2xl border border-edupurple/20 text-xs text-edutext space-y-1">
            <p class="font-bold text-edupurple"><i class="fa-solid fa-circle-info"></i> Panduan Koneksi Supabase</p>
            <p>Masukkan <strong>Project URL</strong> dan <strong>Anon Public Key</strong> dari menu <em>Project Settings &gt; API</em> di dashboard Supabase Anda. Pastikan skrip <code>schema.sql</code> telah dijalankan.</p>
          </div>

          <div>
            <label class="block text-xs font-bold text-edutext mb-1">Supabase Project URL</label>
            <input type="url" id="sb-cfg-url" value="${supabaseConfig.url || ''}" required placeholder="https://xyzcompany.supabase.co" class="w-full px-4 py-2.5 bg-edubg rounded-2xl border border-eduborder text-xs font-mono outline-none focus:border-edupurple">
          </div>

          <div>
            <label class="block text-xs font-bold text-edutext mb-1">Supabase Anon Public API Key</label>
            <input type="text" id="sb-cfg-key" value="${supabaseConfig.anonKey || ''}" required placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." class="w-full px-4 py-2.5 bg-edubg rounded-2xl border border-eduborder text-xs font-mono outline-none focus:border-edupurple">
          </div>

          <div class="flex items-center justify-between pt-3 border-t border-eduborder">
            <button type="button" onclick="testSupabaseConnection()" class="px-3.5 py-2 rounded-xl bg-edubg hover:bg-white text-xs font-bold text-edutext border border-eduborder transition flex items-center gap-1.5">
              <i class="fa-solid fa-vial"></i> Uji Koneksi
            </button>
            <div class="flex gap-2">
              <button type="button" onclick="closeModal()" class="px-4 py-2 rounded-xl bg-edubg text-xs font-bold text-edumuted">Tutup</button>
              <button type="submit" class="px-5 py-2 rounded-xl bg-edupurple text-white text-xs font-bold shadow-clay">Simpan & Hubungkan</button>
            </div>
          </div>
        </form>
      `;
      openModal('Konfigurasi Koneksi Supabase', html);
    }

    async function handleSaveSupabaseConfig(e) {
      e.preventDefault();
      const url = document.getElementById('sb-cfg-url').value.trim();
      const anonKey = document.getElementById('sb-cfg-key').value.trim();

      supabaseConfig = { url, anonKey };
      localStorage.setItem(SUPABASE_CONFIG_KEY, JSON.stringify(supabaseConfig));
      supabaseClient = initSupabaseClient();

      closeModal();
      showToast('Kredensial Supabase disimpan! Memulai sinkronisasi data...');
      await fetchAllFromSupabase();
      renderApp();
    }

    async function testSupabaseConnection() {
      const url = document.getElementById('sb-cfg-url').value.trim();
      const key = document.getElementById('sb-cfg-key').value.trim();
      if (!url || !key) {
        showToast('Mohon masukkan URL dan Anon Key terlebih dahulu.', 'warning');
        return;
      }

      try {
        const testClient = window.supabase.createClient(url, key);
        const { data, error } = await testClient.from('classes').select('id').limit(1);
        if (error) throw error;
        showToast('Koneksi ke database Supabase BERHASIL!');
      } catch (err) {
        showToast('Koneksi gagal: ' + (err.message || 'Periksa URL/Key'), 'danger');
      }
    }

    // Ambil Data Lengkap dari Supabase jika Terkoneksi
    async function fetchAllFromSupabase() {
      if (!supabaseClient) {
        updateSupabaseIndicator(false, 'Mode Lokal / Standalone');
        return;
      }

      try {
        updateSupabaseIndicator(true, 'Menyinkronkan data...');

        // 1. Profil Guru & Siswa
        const { data: profs } = await supabaseClient.from('profiles').select('*');
        if (profs && profs.length > 0) {
          const teacher = profs.find(p => p.role === 'guru');
          if (teacher) {
            appState.teacherProfile = {
              username: teacher.username,
              password: teacher.password,
              fullName: teacher.full_name,
              nip: teacher.nip || '',
              bio: teacher.bio || '',
              avatar: teacher.avatar_url || appState.teacherProfile.avatar
            };
          }
          appState.students = profs.filter(p => p.role === 'siswa').map(s => ({
            id: s.id,
            username: s.username,
            fullName: s.full_name,
            classId: s.class_id,
            password: s.password,
            mustChange: s.must_change_password || false,
            lastLogin: s.last_login_at ? s.last_login_at.replace('T', ' ').substring(0, 16) : null
          }));
        }

        // 2. Kelas
        const { data: cls } = await supabaseClient.from('classes').select('*');
        if (cls && cls.length > 0) {
          appState.classes = cls.map(c => ({ id: c.id, name: c.name, subject: c.subject }));
        }

        // 3. Pengumuman & Komentar
        const { data: anns } = await supabaseClient.from('announcements').select('*').order('created_at', { ascending: false });
        const { data: annComms } = await supabaseClient.from('announcement_comments').select('*');
        if (anns) {
          appState.announcements = anns.map(a => {
            const comments = (annComms || []).filter(c => c.announcement_id === a.id).map(c => ({
              id: c.id,
              author: c.author,
              role: c.role,
              text: c.text,
              date: c.created_at ? c.created_at.replace('T', ' ').substring(0, 16) : ''
            }));
            return {
              id: a.id,
              title: a.title,
              content: a.content,
              teacherName: a.teacher_name,
              date: a.created_at ? a.created_at.replace('T', ' ').substring(0, 16) : '',
              comments
            };
          });
        }

        // 4. Poin Karakter
        const { data: pts } = await supabaseClient.from('student_points').select('*').order('created_at', { ascending: false });
        if (pts && pts.length > 0) {
          appState.points = pts.map(p => ({
            id: p.id,
            studentId: p.student_id,
            studentName: p.student_name,
            classId: p.class_id,
            points: p.points,
            reason: p.reason,
            date: p.incident_date
          }));
        }

        updateSupabaseIndicator(true, 'Tersambung ke Supabase');
        showToast('Data berhasil dimuat dari database Supabase!');
      } catch (err) {
        console.warn('Gagal memuat data dari Supabase, menggunakan state lokal:', err);
        updateSupabaseIndicator(false, 'Offline / Mode Lokal');
      }
    }

    // Sinkronisasi Perubahan ke Supabase di Background
    async function syncStateToSupabase() {
      if (!supabaseClient) return;
      try {
        // Contoh: Sinkronisasi Pengumuman Terbaru
        if (appState.announcements && appState.announcements.length > 0) {
          const latestAnn = appState.announcements[0];
          await supabaseClient.from('announcements').upsert({
            id: latestAnn.id,
            title: latestAnn.title,
            content: latestAnn.content,
            teacher_name: latestAnn.teacherName
          });
        }
      } catch (e) {
        console.warn('Sinkronisasi Supabase tertunda:', e);
      }
    }

    function updateSupabaseIndicator(isConnected, text) {
      const dot = document.getElementById('sb-status-dot');
      const label = document.getElementById('sb-status-text');
      if (dot && label) {
        if (isConnected) {
          dot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse';
          label.innerHTML = `Supabase: <strong class="text-emerald-600 font-extrabold">${text}</strong>`;
        } else {
          dot.className = 'w-2.5 h-2.5 rounded-full bg-amber-500';
          label.innerHTML = `Supabase: <strong class="text-amber-600 font-extrabold">${text}</strong>`;
        }
      }
    }

    function getStudentSPStatus(points) {
      const p = Math.abs(Number(points) || 0);
      if (p >= 1200) {
        return {
          level: 'SP 3',
          label: 'SP 3',
          color: 'red',
          badgeClass: 'bg-red-500 text-white',
          dotClass: 'bg-red-500',
          textClass: 'text-red-600',
          bgLight: 'bg-red-50',
          borderClass: 'border-red-200'
        };
      } else if (p >= 900) {
        return {
          level: 'SP 2',
          label: 'SP 2',
          color: 'orange',
          badgeClass: 'bg-orange-500 text-white',
          dotClass: 'bg-orange-500',
          textClass: 'text-orange-600',
          bgLight: 'bg-orange-50',
          borderClass: 'border-orange-200'
        };
      } else if (p >= 500) {
        return {
          level: 'SP 1',
          label: 'SP 1',
          color: 'yellow',
          badgeClass: 'bg-amber-400 text-amber-950',
          dotClass: 'bg-amber-400',
          textClass: 'text-amber-600',
          bgLight: 'bg-amber-50',
          borderClass: 'border-amber-200'
        };
      } else {
        return {
          level: null,
          label: null,
          color: 'green',
          badgeClass: 'bg-emerald-500 text-white',
          dotClass: 'bg-emerald-500',
          textClass: 'text-emerald-600',
          bgLight: 'bg-emerald-50',
          borderClass: 'border-emerald-200'
        };
      }
    }

    function showToast(message, type = 'success') {
      const box = document.getElementById('toast-box');
      const toast = document.createElement('div');
      const isSuccess = type === 'success';
      const isWarn = type === 'warning';
      const bg = isSuccess ? 'bg-[#7B6CF6] text-white' : isWarn ? 'bg-[#F59EAE] text-white' : 'bg-red-500 text-white';
      const icon = isSuccess ? 'fa-circle-check' : isWarn ? 'fa-triangle-exclamation' : 'fa-circle-xmark';
      
      toast.className = `${bg} px-5 py-3.5 rounded-3xl shadow-xl flex items-center gap-3 text-sm font-semibold pointer-events-auto transform transition-all duration-300 translate-y-2 opacity-0`;
      toast.innerHTML = `<i class="fa-solid ${icon} text-base"></i><span>${message}</span>`;
      
      box.appendChild(toast);
      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      });

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    function calculateStudentAverage(classId, studentId) {
      const scores = appState.gradeScores[classId]?.[studentId] || {};
      const cols = appState.gradeColumns.filter(c => c.classId === classId);
      if (!cols.length) return 0;
      
      let sum = 0;
      let count = 0;
      cols.forEach(c => {
        if (scores[c.id] !== undefined && scores[c.id] !== null) {
          sum += Number(scores[c.id]);
          count++;
        }
      });
      return count > 0 ? (sum / count) : 0;
    }

    function getKatrolFinalScore(classId, studentId) {
      const avg = calculateStudentAverage(classId, studentId);
      const katrol = Number(appState.katrolSettings[classId] || 0);
      return Math.min(100, Math.round(avg + katrol));
    }

    function getLetterGrade(score) {
      if (score >= 90) return 'A';
      if (score >= 80) return 'B';
      if (score >= 70) return 'C';
      if (score >= 60) return 'D';
      return 'E';
    }

    function getStudentPoints(studentId) {
      const list = appState.points.filter(p => p.studentId === studentId);
      return list.reduce((acc, curr) => acc + curr.points, 0);
    }

    function getRecentPoints(studentId, days = 7) {
      return appState.points.filter(p => p.studentId === studentId);
    }

    function openModal(title, contentHtml) {
      document.getElementById('modal-title').innerText = title;
      document.getElementById('modal-body').innerHTML = contentHtml;
      document.getElementById('global-modal').classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('global-modal').classList.add('hidden');
    }
  </script>

